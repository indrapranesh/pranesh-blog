---
import SocialLinks from './SocialLinks.astro';
import { footer } from '../data/footer';

const text = footer.text.replace('{year}', String(new Date().getFullYear()));
// The homepage already shows the links under the introduction.
const showLinks = footer.showSocialLinks && Astro.url.pathname !== '/';
---

<footer class="site-footer">
  {showLinks && <SocialLinks />}
  {text && <p class="footer-text">{text}</p>}
</footer>
