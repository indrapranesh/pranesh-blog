---
import { formatDate, type Post } from '../lib/posts';

interface Props {
  post: Post;
  minutes: number;
}

const { post, minutes } = Astro.props;
const { title, publishedAt, updatedAt, tags, draft } = post.data;
const showUpdated = updatedAt && updatedAt.valueOf() !== publishedAt.valueOf();
---

<header class="post-header">
  <h1>{title}</h1>
  <p class="meta">
    <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
    {
      showUpdated && (
        <>
          {' · updated '}
          <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time>
        </>
      )
    }
    {' · '}{minutes} min read
    {draft && ' · draft'}
  </p>
  <ul class="inline-list meta" aria-label="Tags">
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
</header>
