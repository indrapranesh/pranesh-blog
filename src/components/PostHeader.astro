---
import { formatDate, type Post } from '../lib/posts';

interface Props {
  post: Post;
  minutes: number;
}

const { post, minutes } = Astro.props;
const { title, description, publishedAt, updatedAt, tags, draft } = post.data;
const showUpdated = updatedAt && updatedAt.valueOf() !== publishedAt.valueOf();
---

<header class="post-header">
  <h1 class="post-title">{title}</h1>
  <p class="post-summary">{description}</p>
  <p class="post-meta">
    <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
    {
      showUpdated && (
        <span>
          updated <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time>
        </span>
      )
    }
    <span>{minutes} min read</span>
    {draft && <span>draft</span>}
  </p>
  <ul class="post-tags" aria-label="Tags">
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
</header>
