---
import { formatDate, readingTime, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, publishedAt, tags, draft } = post.data;
---

<li class="entry">
  <time class="entry-date" datetime={publishedAt.toISOString()}>{formatDate(publishedAt, 'short')}</time>
  <a class="entry-title" href={`/posts/${post.id}`}>{title}</a>
  <span class="entry-leader" aria-hidden="true"></span>
  <span class="entry-meta">
    {tags[0]} · {readingTime(post.body)} min{draft && ' · draft'}
  </span>
  <p class="entry-summary">{description}</p>
</li>
