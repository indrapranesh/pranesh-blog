---
import { formatDate, readingTime, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, publishedAt, tags, draft } = post.data;
---

<li class="writing-item">
  <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt, 'short')}</time>
  <div>
    <a href={`/posts/${post.id}`}>{title}</a>
    <p class="meta">
      {tags[0]} · {readingTime(post.body)} min{draft && ' · draft'}
    </p>
  </div>
</li>
