---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getPosts, type Post } from '../../lib/posts';

// One page per post. Drafts are left out of production builds by getPosts().
export async function getStaticPaths() {
  const posts = await getPosts(); // newest first
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer: Post | undefined;
  older: Post | undefined;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<PostLayout post={post} newer={newer} older={older}>
  <Content />
</PostLayout>
