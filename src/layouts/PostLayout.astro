---
import BaseLayout from './BaseLayout.astro';
import PostHeader from '../components/PostHeader.astro';
import PostNav from '../components/PostNav.astro';
import { readingTime, type Post } from '../lib/posts';

interface Props {
  post: Post;
  newer: Post | undefined;
  older: Post | undefined;
}

const { post, newer, older } = Astro.props;
const { title, description, publishedAt, updatedAt, tags } = post.data;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  tags={tags}
>
  <article>
    <p class="back"><a href="/">← All writing</a></p>
    <PostHeader post={post} minutes={readingTime(post.body)} />
    <div class="prose">
      <slot />
    </div>
  </article>
  <PostNav newer={newer} older={older} />
  <p class="back back-bottom"><a href="/">← All writing</a></p>
</BaseLayout>
