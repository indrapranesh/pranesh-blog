---
import BaseLayout from './BaseLayout.astro';
import PostHeader from '../components/PostHeader.astro';
import { readingTime, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, publishedAt, updatedAt, tags } = post.data;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  tags={tags}
>
  <article>
    <p class="back"><a href="/">← Home</a></p>
    <PostHeader post={post} minutes={readingTime(post.body)} />
    <div class="prose">
      <slot />
    </div>
  </article>
  <p class="back back-bottom"><a href="/">← Back to home</a></p>
</BaseLayout>
